{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [


        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Run Inference",
            "type": "debugpy",
            "request": "launch",
            "program": "run_inference.py",
            "console": "integratedTerminal",
            "args": [
                "--debug", "--data", "../datasets/nyuv2", "--device", "cuda"
            ]
        },
                {
            "name": "Python Debugger: Run Inference combined",
            "type": "debugpy",
            "request": "launch",
            "program": "run_inference_combined.py",
            "console": "integratedTerminal",
            "args": [
                "--debug", "--data", "../datasets/nyuv2", "--device", "cuda"
            ]
        }
    ]
}